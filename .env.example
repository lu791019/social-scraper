GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/xxx/edit
GOOGLE_CREDENTIALS_PATH=credentials.json
# CLAUDE_CLI=claude
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# PROXY_URL=http://user:pass@proxy:port

# LINE Bot
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# GitHub (optional, increases rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Notion（一般網頁全文存檔）
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxx

# Webhook server 埠（8000 被其他專案佔用，預設 8010）
# WEBHOOK_PORT=8010

# ngrok 免費靜態網域（dashboard.ngrok.com → Domains 領取，不含 https://）
# 有設 → 網址固定；沒設 → 每次重啟換網址，run_tunnel.sh 會自動同步 LINE webhook
# NGROK_DOMAIN=your-name.ngrok-free.app

# Discord 出口（IG/Threads 完成後以「蛇摸影評」發 embed；不設則略過）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# DISCORD_SNAKE_AVATAR=https://cdn.discordapp.com/avatars/xxx/yyy.png

# 雲端收件服務（Mac 工作程式）
# INBOX_URL=https://social-scraper-inbox-413454635683.asia-east1.run.app
# INBOX_WORKER_KEY=與 Secret Manager social-scraper-inbox 的 worker_key 同值
# WORKER_POLL_SECONDS=30
